# =========================
# Node / Express
# =========================
PORT=5000
JWT_SECRET=YOUR_NEW_JWT_SECRET
JWT_EXPIRES_IN=7d

MONGODB_URI=YOUR_NEW_MONGODB_CONNECTION_STRING

CLIENT_URL=http://localhost:5173

UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800

AI_SERVICE_URL=http://localhost:8001


# =========================
# Session
# =========================
SESSION_SECRET=YOUR_NEW_SESSION_SECRET


# =========================
# Google OAuth
# =========================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback


# =========================
# GitHub OAuth
# =========================
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback


# =========================
# SMTP
# =========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_EMAIL
SMTP_PASS=YOUR_NEW_APP_PASSWORD
EMAIL_FROM=YOUR_EMAIL


# =========================
# AWS / S3 (optional)
# =========================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=


# =========================
# OpenAI
# =========================
OPENAI_API_KEY=YOUR_NEW_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini
AI_REASONING_EFFORT=medium

# Embeddings for RAG
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =========================
# RAG
# =========================
RAG_TOP_K=8
CHUNK_CHARS=4500
CHUNK_OVERLAP=600
MAX_CONTEXT_CHARS=48000
MAX_DOC_CHARS=2000000

# API timeout
OPENAI_TIMEOUT=90